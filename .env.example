# Local dev works with none of these set (in-memory game store, no push, canned AI replies).

# Postgres connection string. On Vercel this is injected by connecting the Supabase
# database to the project. Unset locally = in-memory store (games vanish on restart).
POSTGRES_URL=

# Web Push ("your turn" notifications). Generate with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for the daily timer sweep (Vercel sends it as "Authorization: Bearer ...").
CRON_SECRET=

# Optional, dev server only: Gemini for NPC dialogue + match debrief.
GEMINI_API_KEY=
